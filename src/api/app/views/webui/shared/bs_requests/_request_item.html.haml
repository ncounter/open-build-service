- bs_request_actions = bs_request.bs_request_actions.to_a
- bs_request_actions_types = bs_request_actions.map(&:type).uniq
- reviews = bs_request.reviews.to_a
- comments_count = bs_request.comments.count
- labels = Flipper.enabled?(:labels, User.session) ? bs_request.labels.to_a : []
.list-group-item.list-group-item-action.request-index-item.p-3
  .d-flex.gap-3
    .request-index-icon.text-center{ title: bs_request_actions_types.map { |type| type.humanize.titleize }.to_sentence }
      %i{ class: bs_request_actions_types.one? ? action_type_icon(bs_request_actions_types.first) : 'fas fa-layer-group fa-fw' }
      - if bs_request_actions.many?
        .small.fw-semibold= bs_request_actions.size
    .request-index-content.flex-grow-1
      .d-flex.align-items-start.gap-2
        = link_to(request_show_path(bs_request.number), class: 'request-index-title me-auto text-decoration-none') do
          = render BsRequestActionsSummaryComponent.new(bs_request:, show_versions: Flipper.enabled?(:package_version_tracking, User.session))
        .text-nowrap
          = render BsRequestPriorityBadgeComponent.new(priority: bs_request.priority, overview: true)
          = render BsRequestStateBadgeComponent.new(state: bs_request.state)
      .d-flex.flex-wrap.align-items-center.column-gap-2.small.text-secondary.mt-1
        = link_to("##{bs_request.number}", request_show_path(bs_request.number), id: "request-heading#{bs_request.number}",
                  class: 'font-monospace link-secondary')
        - if labels.any?
          %span
            = render partial: 'webui/shared/label_clickable', collection: labels.first(3), locals: { form: form }, as: :label
            - if labels.size > 3
              %span.badge.text-bg-light.border{ title: labels.drop(3).map(&:name).to_sentence }
                +#{labels.size - 3}
        %span.request-index-description.d-none.d-md-inline.text-truncate.text-body= bs_request.description
        .d-flex.column-gap-3.ms-auto
          %span.text-nowrap
            - if (creator = User.find_by_login(bs_request.creator))
              = render AvatarComponent.new(name: bs_request.creator, email: creator.email, size: 18, custom_css: 'align-text-bottom')
              %span.text-body= bs_request.creator
            - else
              A deleted user
            ·
            = render TimeComponent.new(time: bs_request.created_at)
          - if comments_count.positive?
            %span.text-nowrap{ title: pluralize(comments_count, 'comment') }
              %i.fas.fa-comment
              = comments_count
          - if reviews.any?
            %span.text-nowrap{ title: "#{reviews.count(&:accepted?)} of #{pluralize(reviews.size, 'review')} accepted" }
              %i.fas.fa-magnifying-glass
              #{reviews.count(&:accepted?)}/#{reviews.size}
